# =========================================================================
# HOST nginx (on the Linux server, NOT in a container).
# Terminates TLS for draw.fatihakyol.com and reverse-proxies to the app
# container published on 127.0.0.1:8083 by docker-compose.prod.yml.
#
# Install to e.g. /etc/nginx/sites-available/draw.fatihakyol.com and symlink into
# sites-enabled, then get a certificate:
#   sudo certbot --nginx -d draw.fatihakyol.com
# =========================================================================

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name draw.fatihakyol.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name draw.fatihakyol.com;

    ssl_certificate     /etc/letsencrypt/live/draw.fatihakyol.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/draw.fatihakyol.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8083;
        proxy_http_version 1.1;
        # Pass WebSocket upgrade through for Socket.io.
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;
    }
}
